<!--
  BenchmarkDotNet does not propagate <DirectPInvoke> / <NativeLibrary> csproj properties
  it also opts out of Directory.Build.props/.targets so this is injected via CustomBeforeMicrosoftCommonTargets hook
-->
<Project>
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'">
    <DirectPInvoke Include="bench" />
    <NativeLibrary Condition="$(RuntimeIdentifier.StartsWith('win'))"
                   Include="$(MSBuildThisFileDirectory)runtimes\$(RuntimeIdentifier)\native\static\bench.lib" />
    <NativeLibrary Condition="!$(RuntimeIdentifier.StartsWith('win'))"
                   Include="$(MSBuildThisFileDirectory)runtimes/$(RuntimeIdentifier)/native/static/libbench.a" />
  </ItemGroup>
</Project>
